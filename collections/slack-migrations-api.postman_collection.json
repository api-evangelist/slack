          "name": "Slack Get Migration Exchange",
          "request": {
            "name": "Slack Get Migration Exchange",
            "description": {
              "content": "For Enterprise Grid workspaces, map local user IDs to global user IDs",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "migration.exchange"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "token",
                  "value": "<string>",
                  "description": "(Required) Authentication token. Requires scope: `tokens.basic`"
                },
                {
                  "disabled": false,
                  "key": "users",
                  "value": "<string>",
                  "description": "(Required) A comma-separated list of user ids, up to 400 per request"
                },
                {
                  "disabled": false,
                  "key": "team_id",
                  "value": "<string>",
                  "description": "Specify team_id starts with `T` in case of Org Token"
                },
                {
                  "disabled": false,
                  "key": "to_old",
                  "value": "<boolean>",
                  "description": "Specify `true` to convert `W` global user IDs to workspace-specific `U` IDs. Defaults to `false`."
