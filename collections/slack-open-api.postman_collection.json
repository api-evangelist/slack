          "name": "Slack Post Conversations Open",
          "request": {
            "name": "Slack Post Conversations Open",
            "description": {
              "content": "Opens or resumes a direct message or multi-person direct message.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "conversations.open"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
