          "info": {
            "name": "Set Assistant Thread Status",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/assistant.threads.setStatus",
            "headers": [
              {
                "name": "token",
                "value": ""
              }
            ],
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "channel_id",
                  "value": ""
                },
                {
                  "name": "thread_ts",
                  "value": ""
                },
                {
                  "name": "status",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Sets the status of a Slack AI assistant thread, for example showing a thinking indicator."
        },
        {
          "info": {
            "name": "Set Assistant Thread Suggested Prompts",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/assistant.threads.setSuggestedPrompts",
            "headers": [
              {
                "name": "token",
                "value": ""
              }
            ],
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "channel_id",
                  "value": ""
                },
                {
                  "name": "thread_ts",
                  "value": ""
                },
                {
                  "name": "prompts",
                  "value": ""
                },
                {
                  "name": "title",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Sets the suggested prompts for a Slack AI assistant thread."
        },
        {
          "info": {
            "name": "Set Assistant Thread Title",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/assistant.threads.setTitle",
            "headers": [
              {
                "name": "token",
                "value": ""
              }
            ],
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "channel_id",
                  "value": ""
                },
                {
                  "name": "thread_ts",
                  "value": ""
                },
                {
                  "name": "title",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Sets the title of a Slack AI assistant thread."
        }
      ]
