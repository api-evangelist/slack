          "info": {
            "name": "Slack Set Snooze Duration",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/dnd.setSnooze",
            "body": {
              "type": "json",
              "data": "{}"
            }
