          "info": {
            "name": "Slack Get Admin Teams Admins List",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/admin.teams.admins.list",
            "params": [
              {
                "name": "token",
                "value": "",
                "type": "query",
                "description": "Authentication token. Requires scope: `admin.teams:read`"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "The maximum number of items to return."
              },
              {
                "name": "cursor",
                "value": "",
                "type": "query",
                "description": "Set `cursor` to `next_cursor` returned by the previous call to list items in the next page."
              },
              {
                "name": "team_id",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List all of the admins on a given workspace."
        },
        {
          "info": {
            "name": "Slack Post Admin Teams Create",
            "type": "http"
          },
          "http": {
