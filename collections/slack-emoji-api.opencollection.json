              },
              {
                "name": "include_categories",
                "value": "",
                "type": "query",
                "description": "If true, includes emoji categories."
              }
            ]
          },
          "docs": "Lists custom emoji for a team."
        }
      ]
    }
  ],
  "bundled": true
