{
  "opencollection": "1.0.0",
  "info": {
    "name": "Slack Admin Access Information API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "Information",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Slack Get Do Not Disturb Team Information",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/dnd.teamInfo",
            "params": [
              {
                "name": "token",
                "value": "",
                "type": "query",
                "description": "Authentication token. Requires scope: `dnd:read`"
              },
              {
                "name": "users",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of users to fetch Do Not Disturb status for"
              }
            ]
          },
          "docs": "Retrieves the Do Not Disturb status for up to 50 users on a team."
        }
      ]
    }
  ],
  "bundled": true
}