{
  "opencollection": "1.0.0",
  "info": {
    "name": "Slack Admin Access Scopes API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "Scopes",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Slack Get Apps Permissions Scopes List",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/apps.permissions.scopes.list",
            "params": [
              {
                "name": "token",
                "value": "",
                "type": "query",
                "description": "Authentication token. Requires scope: `none`"
              }
            ]
          },
          "docs": "Returns list of scopes this app has on a team."
        }
      ]
    }
  ],
  "bundled": true
}